rules_version = '2';

// BudgetIQ Firestore security rules.
// Every piece of user data lives under sheets/{sheetId}/**. Access is granted
// only to the Firebase-authenticated user whose uid matches the ownerUid stamped
// on the parent sheets/{sheetId} document (see ensureSheetOwnerFS). Without a
// Firebase identity (request.auth == null) nothing is readable or writable.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The caller owns the sheet if the parent doc's ownerUid is their uid.
    function ownerOf(sheetId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sheets/$(sheetId))
        && get(/databases/$(database)/documents/sheets/$(sheetId)).data.ownerUid == request.auth.uid;
    }

    // Push subscriptions — one doc per device, owned by the uid stored in it
    // (legacy docs were keyed by the uid itself). The send-push function reads
    // them with the Admin SDK, which bypasses these rules.
    match /pushSubscriptions/{id} {
      function mine() { return id == request.auth.uid || resource.data.uid == request.auth.uid; }
      allow read, delete: if signedIn() && mine();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && mine() && request.resource.data.uid == request.auth.uid;
    }

    match /sheets/{sheetId} {
      // Any signed-in user may read the parent doc (it only holds ownerUid),
      // so the client can detect whether a sheet is already claimed.
      allow get: if signedIn();
      // Sign-in finds the caller's own sheet by owner (api/session.js). The
      // query must filter on ownerUid == their uid, or it is refused.
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Claim an unowned sheet: create with your own uid, or fill in ownerUid
      // on a legacy doc that doesn't have one yet. Owners may update their doc.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (!('ownerUid' in resource.data) && request.resource.data.ownerUid == request.auth.uid)
      );
      allow delete: if false;

      // All nested data (categories, expenseMeta, settings/*) is readable and
      // writable only by the sheet's owner. Month documents are written under
      // the stricter rule below (rules OR together, so they're excluded here).
      match /{document=**} {
        allow read: if ownerOf(sheetId);
        allow write: if ownerOf(sheetId) && document[0] != 'months';
      }

      // Expenses and income, one doc per month: months/{YYYY-MM}.
      // Closed years are read-only, same as the app (utils/constants
      // isYearLocked): this year and later are open, and last year stays open
      // through January. request.time is UTC, so the grace edges are ±5.5h in IST.
      // Until the one-time migration has switched this sheet to Firestore
      // (settings/db.source), every year is writable — the migration copies
      // closed years too. Safe to deploy before or after it.
      match /months/{monthId} {
        function yearOf(id) { return int(id.split('-')[0]); }
        function migrated() {
          let p = /databases/$(database)/documents/sheets/$(sheetId)/settings/db;
          return exists(p) && get(p).data.source == 'firestore';
        }
        function open(id) {
          return !migrated()
            || yearOf(id) >= request.time.year()
            || (yearOf(id) == request.time.year() - 1 && request.time.month() == 1);
        }
        allow create, update: if ownerOf(sheetId) && open(monthId)
          && monthId.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.year == yearOf(monthId);
        allow delete: if ownerOf(sheetId) && open(monthId);
      }
    }
  }
}
